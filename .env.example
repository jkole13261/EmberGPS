# EmberGPS — environment variables
# Copy to .env and fill in values before running docker compose up
# NEVER commit the filled-in .env file to source control.

# PostgreSQL password
DB_PASSWORD=change-me-strong-db-password

# Admin API key — used with X-Admin-Key header to manage devices
ADMIN_API_KEY=change-me-strong-admin-key

# GPS history retention in days (0 = keep forever)
DATA_RETENTION_DAYS=90
